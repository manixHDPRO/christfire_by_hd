# Copier vers .env à la racine du projet (même dossier que package.json)

# --- API Node (production : obligatoire) ---
PORT=4000
NODE_ENV=development
JWT_SECRET=remplacer-par-au-moins-32-caracteres-aleatoires
JWT_EXPIRES_IN=8h
DATABASE_PATH=./data/hd-christfire.db

# Origines autorisées si le front est sur un autre domaine (séparées par des virgules)
# CORS_ORIGIN=https://app.votredomaine.fr

# Cookie Secure sur HTTP local : laisser vide ; derrière HTTPS mettre COOKIE_SECURE=1 si besoin
# COOKIE_SECURE=1

# --- Front (Vite, préfixe VITE_) ---
# URL absolue de l’API si le front n’est pas servi par le même hôte (sinon laisser vide = chemins relatifs /api)
# VITE_API_BASE=https://api.votredomaine.fr

# Afficher e-mails / mots de passe de test sur /connexion (déconseillé en prod)
# VITE_SHOW_DEMO_HINT=true

# --- Invitations utilisateurs (SMTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=1
# SMTP_USER=votre-compte@gmail.com
# SMTP_PASS=mot-de-passe-d-application
# MAIL_FROM="HD by ChristFire <votre-compte@gmail.com>"
# APP_PUBLIC_URL=https://app.votredomaine.fr
